# Image from the GitHub Container Registry
PLATESHELF_IMAGE=ghcr.io/schnuecks/plateshelf:latest

# User and group the container runs as (must be allowed to write library and data)
PUID=1000
PGID=1000
TZ=Europe/Berlin

# Port on the host
PORT=8000

# Folder with your .gcode.3mf files and folder for PlateShelf's own data
LIBRARY=./library
DATA=./data

# Seconds between two scans of the library
SCAN_INTERVAL=120
# Size limit per uploaded file in MB
MAX_UPLOAD_MB=1024
# Prepare 3D previews in the background after reading files
PREVIEW_PREBUILD=true
# Days until deleted files are removed permanently from the trash (0 = never)
TRASH_DAYS=30
# Daily automatic backups kept in the data folder under backups/ (0 = off)
BACKUP_KEEP=7

# Default language (en, de, fr, es, it, nl; empty = browser language) and theme
# (system, light, dark). Everyone can change both in the top right of the title bar.
# DEFAULT_LANGUAGE=en
DEFAULT_THEME=system

# Key for encrypting printer credentials. Strongly recommended.
# Create one with: docker compose exec plateshelf python -m app.auth secret
# Keep it safe: without it, stored printer credentials cannot be read.
# SECRET_KEY=
# Sign-in is on: on the first visit you create the admin account with the setup code
# from the log (docker compose logs plateshelf). Users are managed in PlateShelf.
# AUTH=off switches sign-in off, e.g. behind a reverse proxy that signs users in.
# A sign-in lasts SESSION_DAYS days.
# AUTH=off
# SESSION_DAYS=30
# Every sensitive value can also come from a file, e.g. SECRET_KEY_FILE=/run/secrets/plateshelf_key
# Additional addresses allowed to send changes to PlateShelf (comma-separated).
# Usually not needed: PlateShelf's own pages are always allowed.
# TRUSTED_ORIGINS=https://dashboard.example.com

# Direct import from printers (optional). Printers can also be added under
# "Settings"; printers defined here show up there read-only.
# Bambu Lab (FTPS):
# PRINTER_1_NAME=P2S
# PRINTER_1_IP=192.0.2.20
# PRINTER_1_SERIAL=<serial number>
# PRINTER_1_CODE=<access code>
# Klipper via Moonraker (port 7125 unless given, API key only if required):
# PRINTER_2_TYPE=moonraker
# PRINTER_2_NAME=K1
# PRINTER_2_IP=192.0.2.21
# PRINTER_2_API_KEY=
# Prusa via PrusaLink (the user name is "maker"):
# PRINTER_3_TYPE=prusalink
# PRINTER_3_NAME=MK4S
# PRINTER_3_IP=192.0.2.22
# PRINTER_3_PASSWORD=<PrusaLink password>
# More printers with PRINTER_4_…, PRINTER_5_… and so on.
# Seconds between two printer queries
PRINTER_SYNC_INTERVAL=600
# Print history of the configured printers (Bambu via MQTT, Klipper and Prusa queried
# every PRINT_HISTORY_INTERVAL seconds). Usually switched in "Settings"; true or false
# here fixes it and hides the switch.
# PRINT_HISTORY=true
# PRINT_HISTORY_INTERVAL=60
