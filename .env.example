# Image aus der GitHub Container Registry (Benutzername klein geschrieben)
DRUCKARCHIV_IMAGE=ghcr.io/CHANGE-ME/druckarchiv:latest
PUID=1000
PGID=1000
TZ=Europe/Berlin
RESTART=unless-stopped
SECOPTS=no-new-privileges:true
VOL=/opt/docker/services
# Ordner mit den .gcode.3mf-Dateien (z. B. NAS-Mount)
LIBRARY=/mnt/nas/3d-druck
SCAN_INTERVAL=120
MAX_UPLOAD_MB=1024
# 3D-Vorschauen nach dem Einlesen im Hintergrund vorberechnen
PREVIEW_PREBUILD=true
# printers.json aus bambulab-ams-spoolman-filamentstatus (Name, Seriennummer, Zugangscode, IP)
PRINTERS_JSON=/opt/docker/data/spoolman-filamentstatus/printers/printers.json
# Wie oft die Drucker nach neuen Dateien gefragt werden (Sekunden)
PRINTER_SYNC_INTERVAL=600
