# Image from the GitHub Container Registry
PLATESHELF_IMAGE=ghcr.io/schnuecks/plateshelf:latest

# User and group the container runs as (must be allowed to write library and data)
PUID=1000
PGID=1000
TZ=Europe/Berlin

# Port on the host
PORT=8000

# Folder with your .gcode.3mf files and folder for PlateShelf's own data
LIBRARY=./library
DATA=./data

# Seconds between two scans of the library
SCAN_INTERVAL=120
# Size limit per uploaded file in MB
MAX_UPLOAD_MB=1024
# Prepare 3D previews in the background after reading files
PREVIEW_PREBUILD=true
# Days until deleted files are removed permanently from the trash (0 = never)
TRASH_DAYS=30

# Default language (en, de, fr, es, it, nl; empty = browser language) and theme
# (system, light, dark). Everyone can change both in the top right of the title bar.
# DEFAULT_LANGUAGE=en
DEFAULT_THEME=system

# Optional sign-in: set both to turn it on. A sign-in lasts SESSION_DAYS days.
# AUTH_USER=admin
# AUTH_PASSWORD=please-use-a-long-password
# SESSION_DAYS=30
# Additional addresses allowed to send changes to PlateShelf (comma-separated).
# Usually not needed: PlateShelf's own pages are always allowed.
# TRUSTED_ORIGINS=https://dashboard.example.com

# Direct import from Bambu printers (optional). Printers can also be added under
# "Settings"; printers defined here show up there read-only.
# PRINTER_1_NAME=P2S
# PRINTER_1_IP=192.0.2.20
# PRINTER_1_SERIAL=<serial number>
# PRINTER_1_CODE=<access code>
# More printers with PRINTER_2_…, PRINTER_3_… and so on.
# Seconds between two printer queries
PRINTER_SYNC_INTERVAL=600
