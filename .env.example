# Image aus der GitHub Container Registry
DRUCKARCHIV_IMAGE=ghcr.io/schnuecks/druckarchiv:latest

# Benutzer, unter dem der Container läuft (sollte Bibliothek und Daten schreiben dürfen)
PUID=1000
PGID=1000
TZ=Europe/Berlin

# Port auf dem Host
PORT=8000

# Ordner mit den .gcode.3mf-Dateien und Ordner für die Daten des Druckarchivs
LIBRARY=./library
DATA=./data

# Sekunden zwischen zwei Durchläufen durch die Bibliothek
SCAN_INTERVAL=120
# Größenlimit pro hochgeladener Datei in MB
MAX_UPLOAD_MB=1024
# 3D-Vorschauen nach dem Einlesen im Hintergrund vorbereiten
PREVIEW_PREBUILD=true
# Voreingestellte Sprache (de, en, fr, es, it, nl; leer = Sprache des Browsers)
# und Design (system, light, dark). Jeder Browser kann das oben rechts in der Titelleiste ändern.
# DEFAULT_LANGUAGE=de
DEFAULT_THEME=system
# Optionale Anmeldung: beide setzen, um sie einzuschalten. Gilt SESSION_DAYS Tage im Browser.
# AUTH_USER=admin
# AUTH_PASSWORD=bitte-ein-langes-passwort
# SESSION_DAYS=30
# Weitere Adressen, die Änderungen an das Druckarchiv schicken dürfen (durch Komma getrennt).
# Normalerweise nicht nötig: die eigenen Seiten sind immer erlaubt.
# TRUSTED_ORIGINS=https://dashboard.example.com
# Tage, nach denen gelöschte Dateien endgültig aus dem Papierkorb verschwinden (0 = nie)
TRASH_DAYS=30

# Direktimport von Bambu-Druckern (optional). Drucker lassen sich auch unter
# „Einstellungen“ eintragen. Hier vorgegebene erscheinen dort schreibgeschützt.
# PRINTER_1_NAME=P2S
# PRINTER_1_IP=192.0.2.20
# PRINTER_1_SERIAL=<Seriennummer>
# PRINTER_1_CODE=<Zugangscode>
# Weitere Drucker mit PRINTER_2_…, PRINTER_3_… usw.
# Sekunden zwischen zwei Abfragen der Drucker
PRINTER_SYNC_INTERVAL=600
